{
  "info": {
    "_postman_id": "25ws-assignment2-collection",
    "name": "WS Assignment 2 API (Grouped)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection (grouped) for testing WS Assignment 2 API endpoints"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Auth - Signup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"name\": \"테스트 유저\",\n  \"email\": \"testuser@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": [ "{{baseUrl}}" ], "path": [ "auth", "signup" ] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Signup returns 201 status\", function () {pm.response.to.have.status(201);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth - Login (User)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login returns 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.accessToken).to.not.be.undefined;",
                  "pm.environment.set('accessToken', body.data.accessToken);",
                  "pm.environment.set('refreshToken', body.data.refreshToken);",
                  "pm.environment.set('userId', body.data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth - Login (Admin) - (Optional)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test(\"Admin login returns 200\", function () { pm.response.to.have.status(200); });",
                "const body = pm.response.json();",
                "pm.environment.set('adminAccessToken', body.data.accessToken);"
              ] }
            }
          ]
        },
        {
          "name": "Auth - Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": [ "{{baseUrl}}" ], "path": [ "auth", "logout" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"POST /auth/logout returns 200\", function () { pm.expect([200,404,401]).to.include(pm.response.code); });" ] } } ]
        },
        {
          "name": "Auth - Refresh Token",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": [ "{{baseUrl}}" ], "path": [ "auth", "refresh" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"POST /auth/refresh returns 201 or 401\", function () { pm.expect([201,401]).to.include(pm.response.code); });" ] } } ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Users - Get My Profile",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/users/me", "host": [ "{{baseUrl}}" ], "path": [ "users", "me" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"GET /users/me returns 200\", function () { pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Users - Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/users", "host": [ "{{baseUrl}}" ], "path": [ "users" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"GET /users returns 200 or 404\", function () { pm.expect([200,404]).to.include(pm.response.code); });" ] } } ]
        },
        {
          "name": "Users - Get User By Id (Admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": [ "{{baseUrl}}" ], "path": [ "users", "{{userId}}" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"GET /users/:id returns 200 or 404\", function () { pm.expect([200,404]).to.include(pm.response.code); });" ] } } ]
        },
        {
          "name": "Users - Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"바뀐 이름\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me", "host": [ "{{baseUrl}}" ], "path": [ "users", "me" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"PATCH /users/me returns 200\", function () { pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Users - Change My Password",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpass456\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me/password", "host": [ "{{baseUrl}}" ], "path": [ "users", "me", "password" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"PATCH /users/me/password returns 200\", function () { pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Users - Admin Update User",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"관리자에 의한 이름 변경\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": [ "{{baseUrl}}" ], "path": [ "users", "{{userId}}" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"PATCH /users/:id returns 200\", function () { pm.expect([200,404,403]).to.include(pm.response.code); });" ] } } ]
        },
        {
          "name": "Users - Admin Delete User",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": [ "{{baseUrl}}" ], "path": [ "users", "{{userId}}" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"DELETE /users/:id returns 200 or 404\", function () { pm.expect([200,404,403]).to.include(pm.response.code); });" ] } } ]
        },
        {
          "name": "Users - Admin Restore User",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}/restore", "host": [ "{{baseUrl}}" ], "path": [ "users", "{{userId}}", "restore" ] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"PATCH /users/:id/restore returns 200 or 404\", function () { pm.expect([200,404,403]).to.include(pm.response.code); });" ] } } ]
        }
      ]
    }
  ]
}
